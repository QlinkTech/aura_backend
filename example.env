# Contract for every env var the service reads (see app/utils/env_load.py).
# Copy to .env and fill in values. Secrets live in GitHub Actions in prod.

# Core
MONGO_URI=
SECRET_KEY=
APP_PASSWORD=
ADMIN_API_KEY=

# LLM / AI
OPENAI_API_KEY=
GEMINI_API_KEY=
PINECONE_API=
SARVAM_API=
ELEVENLABS_API_KEY=

# Auth / dashboard login
LOGIN_USERNAME=
LOGIN_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage (Cloudflare R2)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# Payments (Razorpay)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_APP_ID=
RAZORPAY_APP_SECRETE=

# WhatsApp (Gupshup)
GUPSHUP_APP_ID=
GUPSHUP_TOKEN=
GUPSHUP_APP_NAME=

# Email (Brevo)
BREVO_API_KEY=

# Misc
FRONTEND_URL=http://localhost:3000
