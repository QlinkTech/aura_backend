{
  "info": {
    "name": "Aura Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_api_key",
      "value": ""
    },
    {
      "key": "log_id",
      "value": ""
    },
    {
      "key": "eft_session_id",
      "value": ""
    },
    {
      "key": "guided_viz_session_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    },
    {
      "key": "resource_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"user_name\": \"Jane Doe\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Check User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/check-user",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Request Reset Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/request-reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset_token>\",\n  \"new_password\": \"newpassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/user-profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I've been feeling overwhelmed lately.\"\n}"
            }
          }
        },
        {
          "name": "Chat History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/chat-history",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Vision Questions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/vision-questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Vision Board",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/vision-board",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Generate Vision Board",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/generate-vision",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"limitless_identity\": \"A visionary CEO\",\n    \"goals\": \"Financial freedom\",\n    \"success_metrics\": \"6-figure income\",\n    \"pinch_moment\": \"Signing my first big client\",\n    \"feelings\": \"Free and abundant\",\n    \"frequency_anchor\": \"Daily gratitude practice\",\n    \"secret_craving\": \"Financial independence\",\n    \"north_star\": \"Peaceful and proud\"\n  },\n  \"vibe\": {\n    \"key\": \"boss\"\n  }\n}"
            }
          }
        },
        {
          "name": "Regenerate Vision Board",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/regenerate-vision",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"limitless_identity\": \"A visionary CEO\",\n    \"goals\": \"Financial freedom\",\n    \"success_metrics\": \"6-figure income\",\n    \"pinch_moment\": \"Signing my first big client\",\n    \"feelings\": \"Free and abundant\",\n    \"frequency_anchor\": \"Daily gratitude practice\",\n    \"secret_craving\": \"Financial independence\",\n    \"north_star\": \"Peaceful and proud\"\n  },\n  \"vibe\": {\n    \"key\": \"healing\"\n  }\n}"
            }
          }
        },
        {
          "name": "Voice to Text",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/voice-to-text",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "Get Journal Prompts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/journal-prompts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Submit Journal Entry",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/journal",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_prompt\": \"What is something you've been carrying lately?\",\n  \"journal_entry\": \"Lately I've been feeling a lot of pressure from work and I haven't been sleeping well. I miss spending time with my family but I feel guilty when I take breaks.\"\n}"
            }
          }
        },
        {
          "name": "List Journal Logs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/journal-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Journal Log",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/journal-logs/{{log_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Delete Journal Log",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/user/journal-logs/{{log_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "SSE Event Stream",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/events",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Keep this connection open. Receives real-time SSE events.\nEvent types: notification | guided_viz_complete | eft_complete\n\nExample payload:\n{ \"type\": \"notification\", \"notif_type\": \"new_masterclass\", \"title\": \"...\", \"body\": \"...\", \"data\": {} }\n{ \"type\": \"guided_viz_complete\", \"session_id\": \"...\", \"audio_url\": \"...\" }\n{ \"type\": \"eft_complete\", \"session_id\": \"...\", \"audio_url\": \"...\" }"
          }
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/notifications/unread-count",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Mark One Read",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/notifications/{{notification_id}}/read",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/notifications/read-all",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List All Resources",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/resources",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List — Masterclass Vault",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/user/resources?category=masterclass_vault",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "resources"],
              "query": [{ "key": "category", "value": "masterclass_vault" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List — Downloadables",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/user/resources?category=downloadables",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "resources"],
              "query": [{ "key": "category", "value": "downloadables" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List — Audio",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/user/resources?category=audio",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "resources"],
              "query": [{ "key": "category", "value": "audio" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Resource",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/resources/{{resource_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "EFT Tapping",
      "item": [
        {
          "name": "Chat (Start / Continue Session)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/eft/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hi, I want to try this\",\n  \"session_id\": null\n}"
            }
          }
        },
        {
          "name": "Chat (Continue Existing Session)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/eft/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I've been feeling anxious about work and don't feel good enough.\",\n  \"session_id\": \"{{eft_session_id}}\"\n}"
            }
          }
        },
        {
          "name": "List EFT Sessions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/eft/sessions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get EFT Session",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/eft/sessions/{{eft_session_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Delete EFT Session",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/user/eft/sessions/{{eft_session_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Guided Visualization",
      "item": [
        {
          "name": "Generate Visualization",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/guided-viz/generate",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I've been feeling really anxious and overwhelmed lately. Work stress is building up and I can't seem to switch off.\"\n}"
            }
          }
        },
        {
          "name": "List Guided Viz Sessions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/guided-viz/sessions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Guided Viz Session",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/guided-viz/sessions/{{guided_viz_session_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Delete Guided Viz Session",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/user/guided-viz/sessions/{{guided_viz_session_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Early Bird Subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payment/early-bird-subscription",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"plan_key\": \"3_months_plan\",\n  \"expire_by\": null\n}"
            }
          }
        },
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payment/subscribe",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"plan_key\": \"1_year_plan\",\n  \"expire_by\": null\n}"
            }
          }
        },
        {
          "name": "Get Subscription",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/payment/subscription?email=user@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "payment", "subscription"],
              "query": [{ "key": "email", "value": "user@example.com" }]
            },
            "header": [
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ]
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payment/cancel-subscription",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"cancel_at_cycle_end\": false\n}"
            }
          }
        },
        {
          "name": "Pause Subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payment/pause-subscription",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Webhook (Razorpay)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/payment/webhook",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "<signature>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {}\n    }\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Dashboard Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Get System Prompt",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/system/prompt"
          }
        },
        {
          "name": "Update System Prompt",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/system/prompt",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"You are Aura, a warm and empathetic AI wellness companion...\"\n}"
            }
          }
        },
        {
          "name": "Resources - Upload Thumbnail",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/resources/thumbnail",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "description": "Compresses image to 400px JPEG and uploads to R2. Returns thumbnail_url and thumbnail_r2_key to include in the Add Resource call."
          }
        },
        {
          "name": "Resources - Get Presigned URL",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/resources/presigned-url",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"sample.mp3\",\n  \"content_type\": \"audio/mpeg\"\n}"
            }
          }
        },
        {
          "name": "Resources - Add (after upload)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/resources",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Morning Abundance Meditation\",\n  \"category\": \"audio\",\n  \"description\": \"A 10-minute morning abundance meditation to start your day.\",\n  \"r2_key\": \"resources/<uuid>.mp3\",\n  \"url\": \"https://...\",\n  \"thumbnail_url\": \"https://...\",\n  \"thumbnail_r2_key\": \"thumbnails/<uuid>.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "category must be one of: masterclass_vault | downloadables | audio\nAutomatically pushes a notification to all users on success."
          }
        },
        {
          "name": "Resources - List All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/system/resources",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Resources - List by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/system/resources?category=audio",
              "host": ["{{base_url}}"],
              "path": ["api", "system", "resources"],
              "query": [{ "key": "category", "value": "audio" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Resources - Update",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/system/resources/{{resource_id}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"category\": \"downloadables\",\n  \"description\": \"Updated description.\"\n}"
            }
          }
        },
        {
          "name": "Resources - Delete",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/system/resources/{{resource_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "KB - Upload PDF",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/kb/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "KB - Add Text",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/system/kb/add-text",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"CBT techniques for anxiety include...\"\n}"
            }
          }
        },
        {
          "name": "KB - List All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/system/kb/all"
          }
        },
        {
          "name": "KB - Get by ID",
